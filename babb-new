# ── CHANGELOG FLOW ──────────────────────────────────────────────────────────
def bump_patch(ver)
  return nil if ver.nil?
  ver.to_s =~ /^(v?\d+\.\d+\.)(\d+)$/ ? "#{$1}#{$2.to_i + 1}" :
  ver.to_s =~ /^(v?\d+\.)(\d+)$/      ? "#{$1}#{$2.to_i + 1}" : nil
end

def flow_changelog
  section 'Changelog Entry'
  products = load_products

  prod = menu('Product', products.map { |p|
    { val: p['id'], label: "#{p['name'].ljust(16)} #{C.dim("currently #{p['ver']}")}" }
  }, allow_skip: false)
  return unless prod
  prod_id = prod[:val]

  clog_path = File.join(SITE_ROOT, '_data', 'changelogs', "#{prod_id}.yml")
  existing  = File.exist?(clog_path) ? (YAML.load_file(clog_path) || []) : []
  latest_ver = existing.first&.dig('ver')
  suggested  = bump_patch(latest_ver)

  puts
  puts "  #{C.dim("Latest: #{latest_ver || 'none'}  →  suggesting #{suggested || 'no suggestion'}")}" if latest_ver
  ver     = ask('Version', default: suggested)
  date    = ask('Date', default: Date.today.to_s)
  head    = ask('Summary headline (becomes bold — one tight sentence)')
  body    = ask('Detail (optional — rest of the sentence/paragraph)')
  changes = ask('Individual change count', default: '1').to_i

  new_entry = { 'ver' => ver, 'date' => date, 'head' => head,
                'body' => (body && !body.empty? ? body : nil),
                'changes' => changes }.compact

  puts
  puts "  #{C.b('Entry:')}"
  puts "  #{C.y(ver)}  #{C.dim(date)}  #{C.b(head)} #{body}  #{C.dim("(#{changes} changes)")}"
  puts

  return unless confirm('Prepend to changelog?')

  existing.unshift(new_entry)
  FileUtils.mkdir_p(File.dirname(clog_path))
  File.write(clog_path, existing.to_yaml)
  puts "  #{C.g('✓')} _data/changelogs/#{prod_id}.yml  #{C.dim("(#{existing.size} entries total)")}"

  # Offer to also update the ver string in products.yml
  if confirm("Update products.yml version to #{ver}?")
    prods = load_products
    target = prods.find { |p| p['id'] == prod_id }
    if target
      target['ver'] = ver
      File.write(File.join(SITE_ROOT, '_data/products.yml'), prods.to_yaml)
      puts "  #{C.g('✓')} products.yml ver → #{ver}"
    end
  end
end

# ── TELEMETRY FLOW ───────────────────────────────────────────────────────────
TELEM_PATH     = 'feed/telemetry.json'
TELEM_SUBJECTS = %w[workpads bitpads .tel places editorial babb].freeze
TELEM_MAX      = 24

def flow_telemetry
  section 'Telemetry Entry'

  subj_item = menu('Subject / channel',
    TELEM_SUBJECTS.map { |s| { val: s, label: s } },
    allow_skip: false, allow_new: true, new_label: 'type a custom subject')
  return unless subj_item
  subj = subj_item == :new ? ask('Subject') : subj_item[:val]
  return puts "  #{C.r('Subject required.')}" if subj.nil? || subj.empty?

  msg = ask('Message (short, terminal-style — no caps, no period)')
  return puts "  #{C.r('Message required.')}" if msg.nil? || msg.empty?

  ts   = Time.now.strftime('%H:%M:%S')
  line = { 'ts' => ts, 'subj' => subj, 'msg' => msg }

  puts
  puts "  #{C.b('Line:')}  #{C.dim(ts)}  #{C.y(subj)}  #{msg}"
  puts
  return unless confirm('Add to telemetry.json?')

  json_path = File.join(SITE_ROOT, TELEM_PATH)
  data = JSON.parse(File.read(json_path)) rescue { 'lines' => [] }
  data['lines'].unshift(line)
  data['lines'] = data['lines'].first(TELEM_MAX)
  File.write(json_path, JSON.pretty_generate(data))
  puts "  #{C.g('✓')} #{TELEM_PATH}  #{C.dim("(#{data['lines'].size} / #{TELEM_MAX} lines)")}"
end

