PLACE_SETS = {
  'full'  => %w[angle field-notes broll],
  'light' => %w[angle field-notes],
}.freeze

def flow_place_batch(place_slug, place_title, types)
  puts
  puts "  #{C.dim('Title for each sub-page (Enter to accept default):')}"

  # Collect titles upfront
  pages = types.map do |type|
    default_title = "#{place_title} — #{humanize(type)}"
    title = ask("  #{type}", default: default_title)
    { type: type, slug: type, title: title }
  end

  # Build full ctx_links for the whole set + any already on disk
  existing_ctx = ctx_links_for(place_slug)
  batch_ctx    = pages.map { |p| { url: "/places/#{place_slug}/#{p[:slug]}/", title: p[:title] } }
  all_ctx      = (existing_ctx + batch_ctx).uniq { |l| l[:url] }.sort_by { |l| l[:url] }

  puts
  pages.each do |p|
    rel_path = "places/#{place_slug}/#{p[:slug]}/index.html"
    content  = build_subpage(p[:type], place_slug, place_title, p[:title], p[:slug], all_ctx)
    safe_write(rel_path, content)
  end
  puts "  #{C.g('✓')} #{pages.size} sub-pages written, ctx_links cross-wired"
end

def flow_place_subpages(place_slug, place_title)
  set_item = menu('Sub-page setup', [
    { val: 'full',   label: "Full standard  #{C.dim('— angle + field-notes + broll')}" },
    { val: 'light',  label: "Light set      #{C.dim('— angle + field-notes')}" },
    { val: 'custom', label: "Custom         #{C.dim('— add pages one at a time')}" }
  ], allow_skip: true, skip_label: 'skip for now')
  return unless set_item

  case set_item[:val]
  when 'full', 'light'
    flow_place_batch(place_slug, place_title, PLACE_SETS[set_item[:val]])
  when 'custom'
    flow_place_subpage(place_slug, place_title)
  end
end

